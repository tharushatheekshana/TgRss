# Telegram Bot token from @BotFather
TG_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# Target Telegram Channel (@channel_username) or Chat/Channel ID (e.g. -1001234567890)
TG_CHAT_ID=@your_channel_username

# Language: si (Sinhala) or en (English)
ESANA_LANG=si

# Category: 1=All, 2=Incidents, 3=Voice, 4=Announcements, 5=Statements
ESANA_CATEGORY=1

# Poll interval in seconds (default: 30 seconds)
POLL_INTERVAL=30

# Number of latest news items to post on the very first run (default: 1)
INITIAL_POST_LIMIT=1
